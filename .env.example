# AI-compatible gateway. Keep every value in Vercel Environment Variables.
AI_BASE_URL=https://your-openai-compatible-gateway.example/v1
AI_MODEL=your-model-name
AI_API_KEY=
AI_TIMEOUT_MS=12000

# Fuyao server-side adapter. Never put this key in browser code.
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=
FUYAO_TIMEOUT_MS=8000
FUYAO_MAX_CONCURRENCY=4
FUYAO_MAX_SYMBOLS=0
FUYAO_UNIVERSE_PATH=/api/meta/tickers/list
FUYAO_VALUATION_PATH=/api/a-share/valuations/snapshot
FUYAO_FINANCIAL_PATH=/api/a-share/financials/indicators
FUYAO_KLINE_PATH=/api/a-share/prices/historical
FUYAO_REPORT=auto
# The provider also supports the verified snapshot endpoint:
# /api/a-share/prices/snapshot

# Anonymous memory database.
DATABASE_URL=
ANON_SESSION_SECRET=replace-with-a-long-random-value
MEMORY_TTL_DAYS=90

# Set only in a local preview or a deliberately public demo deployment.
DEMO_MODE=true
